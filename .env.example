# Скопировать в .env и заполнить. .env в git не уходит.
# Ключ меняется в любой момент: выпустить новый в Yandex Cloud, заменить здесь,
# перезапустить исполнитель, старый удалить в консоли.
YASEO_APP_DSN=dbname=yaseo_app
# fake — виртуальные данные без трат, live — настоящие поставщики по ключам ниже
YASEO_SOURCES=fake
YC_FOLDER_ID=
YANDEX_AI_STUDIO_API_KEY=

# Боевой сервер (домен yaseo.site, рег.ру). Локально не задавать — ссылки в письмах
# ведут на http://127.0.0.1:8000.
# YASEO_BASE_URL=https://yaseo.site
# YASEO_MAIL_FROM=noreply@yaseo.site
# YASEO_SUPPORT_EMAIL=help@yaseo.site
# YASEO_SITE_DOMAIN=yaseo.site
