<!doctype html>
<html lang="ru" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand.name if brand and brand.name else 'yaseo' }} — проверка {{ host }}</title>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Montserrat:wght@800;900&display=swap" rel="stylesheet">
<style>
{{ css|safe }}
</style>
</head>
<body>
<div class="page">
{% if back_url %}<a class="back" href="{{ back_url }}">← Вернуться к проверке</a>{% endif %}

<header class="head">
  <div>
    {% if brand %}
    <div class="brand">{% if brand.logo %}<img class="brand-logo" src="{{ brand.logo }}" alt="{{ brand.name or '' }}">{% endif %}{% if brand.name %}<span class="brand-name">{{ brand.name }}</span>{% endif %}</div>
    {% else %}
    <div class="wordmark" aria-label="yaseo"><span class="ya">ya</span>seo</div>
    {% endif %}
    <h1 style="margin-top:18px">Проверка сайта <span class="u">{{ host }}</span></h1>
    <p class="muted" style="margin-top:6px">{{ kind }}</p>
  </div>
  <div class="meta small muted">
    <div>Снято {{ collected_at }}</div>
    <div>Проверено: {{ pages_crawled }} {{ pages_crawled|pages_word }}</div>
  </div>
</header>

<div class="verdict">
  <div>
    <div class="score">
      {% if total is not none %}
      <div class="num {{ color }}">{{ total }}</div><div class="of">из 100</div>
      {% else %}
      <div class="num none">Не измерено</div>
      {% endif %}
    </div>
    <p class="lead muted">{{ verdict_text }}</p>
  </div>
  <div class="lights">
    {% for l in lights %}
    <div class="light">
      <div class="dot {{ l.color }}"></div>
      <div><b>{{ l.name }}</b><div class="micro muted">{{ l.note }}</div>{% if l.key == 'tech' and l.score is not none and l.score < 30 %}<div class="micro muted">почти на каждой странице есть замечания</div>{% endif %}</div>
      {% if l.score is not none %}<div class="val">{{ l.score }}</div>{% else %}<div class="val none">не измерено</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</div>

<section>
  <div class="sec-head"><span class="n">01</span><h2>Что сделать первым</h2></div>
  {% if steps %}
  <p class="muted" style="margin-bottom:20px"><span class="u">{{ steps|length }} {{ steps|length|plural('шаг', 'шага', 'шагов') }}</span> по убыванию важности. У каждого — что не так, что сделать, кто и сколько времени.</p>
  <div class="steps">
    {% for s in steps %}
    <div class="step">
      <div class="idx {{ s.severity }}">{{ loop.index }}</div>
      <div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.problem }}</p>
        <p class="action">{{ s.action }}</p>
        <div class="row">
          <div><span>Кто</span>{{ s.who }}</div>
          <div><span>Время</span>{{ s.time }}</div>
          <div><span>Где</span>{{ s.pages }} {{ s.pages|pages_word }}</div>
          <div><span>Важность</span><span class="tag {{ {'critical':'bad','major':'warn','minor':'quiet'}[s.severity] }}">{{ {'critical':'срочно','major':'важно','minor':'мелочь'}[s.severity] }}</span></div>
        </div>
        <details class="evidence"{% if expand %} open{% endif %}><summary>Подробности для разработчика</summary><div style="margin-top:8px">Страница <span class="mono">{{ s.urls[0]|short }}</span>: {{ s.evidence }}</div></details>
        {% if s.effect %}<p class="small muted" style="margin-top:10px">Что изменится: {{ s.effect }}</p>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="pending"><h3>Находок нет</h3><p class="muted">По проверенным страницам замечаний не найдено.</p></div>
  {% endif %}
</section>

<section>
  <div class="sec-head"><span class="n">02</span><h2>Спрос</h2></div>
  {% set dem = (paid or {}).get('demand') %}
  {% if dem and dem['items'] %}
  <p class="muted" style="margin-bottom:14px">Сколько раз в месяц люди вводят эти фразы в Яндексе. Данные берём из Яндекс Вордстата — сервиса, где Яндекс показывает частоту запросов.</p>
  <table>
    <tr><th>Фраза</th><th class="num">Ищут раз в месяц</th></tr>
    {% for it in dem['items'] %}<tr><td>{{ it.query }}</td><td class="num">{{ it.error or it.freq|num }}</td></tr>{% endfor %}
  </table>
  {% else %}
  <div class="pending">
    <h3>{% if paid %}Данных нет{% else %}В бесплатной проверке не измеряется{% endif %}</h3>
    <p class="muted">{% if paid %}{{ (dem or {}).get('reason') or 'Фразы не заданы или данные Вордстата не получены.' }}{% else %}Сколько людей в месяц ищут ваши услуги и какую долю видите вы: считается в полном аудите по данным Яндекса о частоте запросов.{% endif %}</p>
  </div>
  {% endif %}
</section>

<section>
  <div class="sec-head"><span class="n">03</span><h2>Позиции и конкуренты</h2></div>
  {% set pos = (paid or {}).get('positions') %}
  {% if pos and pos['items'] %}
  <p class="muted" style="margin-bottom:14px">На каком месте ваш сайт в поиске Яндекса по каждой фразе и кто стоит в самом верху{% if region_label %}. Выдача: {{ region_label }}{% endif %}.</p>
  <table>
    <tr><th>Фраза</th><th class="num">Ваше место</th>{% for w in rivals %}<th class="num">{{ w }}</th>{% endfor %}<th>Кто на первых местах</th></tr>
    {% for it in pos['items'] %}<tr><td class="q">{{ it.query }}</td>
      <td class="num">{% if it.error %}<span class="rank">ошибка</span>{% elif it.position %}<span class="rank {{ 'ok' if it.position <= 3 else ('warn' if it.position <= 10 else 'bad') }}">{{ it.position }}</span>{% else %}<span class="rank bad">нет в топ-10</span>{% endif %}</td>
      {% for w in rivals %}<td class="num muted">{{ (it.watched or {}).get(w) or '—' }}</td>{% endfor %}
      <td><div class="tops">{% for d in (it.top3 or []) %}<span{% if serp_kind(d) != 'обычный' %} class="agg" title="{{ serp_kind(d) }}"{% endif %}>{{ d }}</span>{% endfor %}</div></td></tr>{% endfor %}
  </table>
  {% if serp_note and serp_note.aggregators %}
  <p class="serp-note">В первых тройках {{ serp_note.aggregators }} из {{ serp_note.total }} {{ serp_note.total|plural('место', 'места', 'мест') }} занимают агрегаторы и справочники ({{ serp_note.names|join(', ') }}); они подсвечены. По общим фразам обогнать их трудно. Разместите сайт и карточку компании на этих площадках и добавьте уточнённые фразы: с районом, ценой, названием услуги.</p>
  {% endif %}
  {% else %}
  <div class="pending">
    <h3>{% if paid %}Данных нет{% else %}В бесплатной проверке не измеряется{% endif %}</h3>
    <p class="muted">{% if paid %}{{ (pos or {}).get('reason') or 'Фразы не заданы или выдача не получена.' }}{% else %}Где сайт стоит в поиске Яндекса по своим запросам и кто стоит выше: снимается в полном аудите.{% endif %}</p>
  </div>
  {% endif %}
</section>

<section>
  <div class="sec-head"><span class="n">04</span><h2>Нейросети</h2></div>
  <p class="muted" style="margin-bottom:18px">Всё больше людей спрашивают нейросеть вместо поиска. Здесь два вопроса: может ли нейросеть прочитать ваш сайт и называет ли она вас, когда отвечает на вопросы ваших клиентов.</p>
  <div class="ai-brief">
    <p><span class="dot {{ ai.readable[0] }}"></span><span>{{ ai.readable[1] }}</span></p>
    {% if ai.mention %}<p><span class="dot {{ ai.mention[0] }}"></span><span>{{ ai.mention[1] }}</span></p>{% endif %}
  </div>

  {% set ans = (paid or {}).get('answers') %}
  {% if ans and ans['items'] %}
  <h3 style="margin:24px 0 8px">Что отвечает нейросеть Яндекса</h3>
  <p class="muted" style="margin-bottom:14px">Мы задали нейросети ваши фразы так, как их задал бы клиент. «Называет вас» значит, что сайт попал в её ответ как источник.</p>
  <table>
    <tr><th>Фраза</th><th>Называет вас</th>{% for w in rivals %}<th>{{ w }}</th>{% endfor %}<th>Кого называет вместо вас</th></tr>
    {% for it in ans['items'] %}<tr><td>{{ it.query }}</td>
      <td>{% if it.error %}ошибка{% elif it.cited %}да, источник №{{ it.cited_position }}{% else %}нет{% endif %}</td>
      {% for w in rivals %}<td class="muted">{% if (it.watched or {}).get(w) %}да{% elif it.watched %}нет{% else %}—{% endif %}</td>{% endfor %}
      <td class="muted">{{ (it.rivals or [])|join(', ') }}</td></tr>{% endfor %}
  </table>
  {% endif %}

  {% set step_titles = steps|map(attribute='title')|list %}
  {% set ai_extra = ai.fixes|rejectattr('title', 'in', step_titles)|list %}
  {% if ai.fixes and not ai_extra %}
  <p class="muted" style="margin-top:24px">Что исправить, чтобы нейросети лучше вас понимали, уже в списке шагов в разделе 01.</p>
  {% elif ai_extra %}
  <h3 style="margin:28px 0 10px">{% if ai_extra|length < ai.fixes|length %}Ещё что исправить для нейросетей{% else %}Что исправить, чтобы нейросети лучше вас понимали{% endif %}</h3>
  {% if ai_extra|length < ai.fixes|length %}<p class="muted small" style="margin-bottom:8px">Остальное — в шагах раздела 01.</p>{% endif %}
  <ol class="ai-fixes">
    {% for f in ai_extra %}
    <li><b>{{ f.title }}</b>{% if f.count > 1 %} <span class="muted small">(на {{ f.count }} стр.)</span>{% endif %}
      <div class="small">{{ f.problem }}</div>
      <div class="small"><b>Что сделать:</b> {{ f.action }}</div>
      <div class="small muted">{{ f.effect }}</div></li>
    {% endfor %}
  </ol>
  {% endif %}

  <details class="fold"{% if expand %} open{% endif %} style="margin-top:24px">
    <summary>Для разработчика: файлы, роботы нейросетей, разметка</summary>
    <p class="muted small" style="margin:10px 0 12px"><b>robots.txt</b> говорит роботам, куда им можно заходить. <b>llms.txt</b> и <b>llms-full.txt</b> — необязательные памятки для нейросетей: о чём сайт и где главные страницы. Разметка (JSON-LD) в коде страницы подсказывает нейросети, что это за компания, услуга или статья.</p>
    <table style="margin-bottom:20px">
      <tr><th>Что</th><th>Состояние</th></tr>
      <tr><td>robots.txt</td><td>{{ geo.robots_txt }}</td></tr>
      <tr><td>llms.txt — путеводитель для нейросетей</td><td>{{ geo.llms_txt }}</td></tr>
      <tr><td>llms-full.txt — полный текст</td><td>{{ geo.llms_full_txt }}</td></tr>
    </table>
    <h3 style="margin-bottom:6px">Роботы нейросетей</h3>
    <p class="muted small" style="margin-bottom:10px">«Показ в ответах» — робот ищет страницы, чтобы ссылаться на них в ответе. «Заход по просьбе пользователя» — человек сам попросил нейросеть открыть сайт. «Обучение моделей» — робот собирает тексты, чтобы учить нейросеть.</p>
    <div class="bots">
      {% for b in geo.bots %}
      <div class="bot">
        <div class="dot {{ 'green' if b.allowed else ('red' if b.role == 'search' else ('yellow' if b.role == 'user' else 'grey')) }}"></div>
        <div><b>{{ b.owner }} · {{ b.token }}</b><span class="small muted">{{ {'search':'показ в ответах','user':'заход по просьбе пользователя','training':'обучение моделей'}.get(b.role, b.role) }} — {{ 'разрешён' if b.allowed else 'закрыт' }}</span></div>
      </div>
      {% endfor %}
    </div>
    {% if geo.good %}
    <h3 style="margin:20px 0 8px">Что уже хорошо</h3>
    <div class="issues">{% for g in geo.good %}<div class="issue"><span class="tag" style="justify-self:start">есть</span><span class="small">{{ g }}</span></div>{% endfor %}</div>
    {% endif %}
  </details>
</section>

<section>
  <div class="sec-head"><span class="n">05</span><h2>Техника по страницам</h2></div>
  {% if speed and speed.status == 'ok' %}
  <div class="speed">
    <h3>Скорость на телефоне</h3>
    <div class="speed-row">
      <div><span class="rank {{ 'ok' if speed.score >= 90 else ('warn' if speed.score >= 50 else 'bad') }}">{{ speed.score }}</span><small>оценка из 100</small></div>
      {% if speed.lcp_s is not none %}<div><b>{{ speed.lcp_s|string|replace('.', ',') }} с</b><small>главное на странице появляется (хорошо — до 2,5 с)</small></div>{% endif %}
      {% if speed.cls is not none %}<div><b>{{ speed.cls|string|replace('.', ',') }}</b><small>насколько страница «прыгает» при загрузке (хорошо — до 0,1)</small></div>{% endif %}
    </div>
    <p class="muted small">Замер Google PageSpeed для главной страницы, как её открывает телефон. Исправления — в шагах выше, если они нужны.</p>
  </div>
  {% endif %}
  <p class="muted" style="margin-bottom:16px">Для специалиста: что увидел робот на каждой проверенной странице.</p>
  <details class="fold"{% if expand %} open{% endif %}>
  <summary>Все находки <span class="muted">— {{ issues|length }}</span></summary>
  <div class="issues">
    {% for i in issues %}
    <div class="issue">
      <span class="tag {{ {'critical':'bad','major':'warn','minor':'quiet'}[i.severity] }}" style="justify-self:start">{{ {'critical':'срочно','major':'важно','minor':'мелочь'}[i.severity] }}</span>
      <div><b>{{ i.title }}</b> <span class="mono muted">{{ i.url|short }}</span><div class="muted">{{ i.evidence }}</div></div>
    </div>
    {% endfor %}
  </div>
  </details>

  <details class="fold"{% if expand %} open{% endif %}>
  <summary>Таблица страниц <span class="muted">— {{ pages|length }}</span></summary>
  <table>
    <tr><th>Страница</th><th>Код</th><th class="num">Заголовок</th><th class="num">Описание</th><th class="num">H1</th><th>Основной адрес</th><th class="num">Слов</th><th class="num">Картинок без подписи</th></tr>
    {% for p in pages %}
    <tr{% if p.status is none or p.status >= 400 %} class="bad"{% endif %}>
      <td class="mono">{{ p.url|short }}</td>
      <td><span class="status{% if p.status is none or p.status >= 400 %} err{% endif %}">{{ p.status if p.status is not none else '—' }}</span></td>
      <td class="num">{{ p.title_len or '—' }}</td>
      <td class="num">{{ p.description_len or '—' }}</td>
      <td class="num">{{ p.h1|length }}</td>
      <td class="mono">{{ p.canonical|short if p.canonical else '—' }}</td>
      <td class="num">{{ p.word_count }}</td>
      <td class="num">{{ p.images_no_alt }}/{{ p.images_total }}</td>
    </tr>
    {% endfor %}
  </table>
  </details>
</section>

<section>
  <div class="sec-head"><span class="n">06</span><h2>Как считали</h2></div>
  <p>Сайт обошёл наш робот: до {{ max_pages }} страниц, переходя по ссылкам с главной и по карте сайта. У каждой находки есть подтверждение со страницы — подробности свёрнуты под шагом, для разработчика. Готовность к нейросетям проверили по служебным файлам сайта и по тому, как устроены {{ geo.pages|length }} {{ geo.pages|length|pages_word }}.</p>
  <p style="margin-top:10px">Оценка: чем серьёзнее замечание, тем больше баллов оно отнимает: срочное — 10, важное — 3, мелочь — 1. Зелёный цвет — от 80 баллов, жёлтый — от 50. Что не измерялось, в оценку не входит. Гарантий позиций нет и быть не может: порядок выдачи определяет Яндекс.</p>
</section>

<footer class="foot">
  {% if brand %}<span class="brand-contacts">{{ brand.name or '' }}{% if brand.contacts %}{% if brand.name %} · {% endif %}{{ brand.contacts }}{% endif %}</span>{% else %}<span>yaseo · движок {{ engine }}</span>{% endif %}
  <span>{{ collected_at }}</span>
</footer>

</div>
</body>
</html>
