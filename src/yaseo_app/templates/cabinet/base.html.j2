<!doctype html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Кабинет{% endblock %} — yaseo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Montserrat:wght@800;900&display=swap" rel="stylesheet">
{% block head %}{% endblock %}
<style>
{{ css|safe }}
</style>
</head>
<body>
<header class="bar">
  <a class="wordmark" href="/" aria-label="yaseo"><span class="ya">ya</span>seo</a>
  <nav>
    {% if user %}
      <a href="/sites">Мои сайты</a>
      <a href="/billing">Тариф</a>
      <a href="/settings">Настройки</a>
      <span class="muted">{{ user.actor_email or user.email }}</span>
      <form method="post" action="/logout">
        <input type="hidden" name="csrf" value="{{ user.csrf }}">
        <button class="linkbtn" type="submit">Выйти</button>
      </form>
    {% elif path != "/login" %}
      <a href="/login">Войти</a>
    {% endif %}
  </nav>
</header>
<main class="wrap">
{% if user and not user.email_confirmed_at %}
<form class="note fake confirm-bar" method="post" action="/confirm/resend">
  <input type="hidden" name="csrf" value="{{ user.csrf }}">
  <span>Подтвердите почту {{ user.email }} — ссылка в письме. До этого проверки не запускаются.</span>
  <button class="linkbtn" type="submit">Отправить ещё раз</button>
</form>
{% endif %}
{% block main %}{% endblock %}
</main>
</body>
</html>
