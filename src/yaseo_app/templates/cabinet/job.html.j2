{% extends "cabinet/base.html.j2" %}
{% block title %}Проверка {{ job.id }}{% endblock %}
{% block head %}{% if job.status in ('queued', 'running') %}<meta http-equiv="refresh" content="3">{% endif %}{% endblock %}
{% block main %}
<div class="stack">
  <div>
    <div class="crumbs"><a href="/sites">Сайты</a> / <a href="/sites/{{ job.site_id }}">{{ job.params.url }}</a> /</div>
    <h1>Проверка №{{ job.id }} <span class="pill {{ job.status }}" style="vertical-align:middle">{{ STATUS_TITLES[job.status] }}</span></h1>
  </div>

  {% if job.status in ('queued', 'running') %}
  <div class="card">
    {% if progress.queued %}
    <p>Проверка в очереди{% if progress.ahead %} — перед ней {{ progress.ahead }} {{ progress.ahead|plural('проверка', 'проверки', 'проверок') }}{% endif %}{% if job.error %} — {{ job.error }}{% endif %}. Начнётся автоматически.</p>
    <div class="progress" aria-hidden="true"><i></i></div>
    {% else %}
    <div class="progress-head">
      <p>Проверяем сайт{% if job.params.queries %} и собираем данные Яндекса{% endif %}.
        {% if progress.over %}Почти готово, ещё немного.{% else %}Осталось примерно {{ progress.left }}.{% endif %}</p>
      <span class="progress-pct" aria-live="polite">{{ progress.pct }}%</span>
    </div>
    <div class="progress known" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress.pct }}" style="--pct: {{ progress.pct }}%"><i></i></div>
    {% endif %}
    <p class="muted small" style="margin-top:12px">Страница обновляется сама. Можно закрыть её — проверка продолжится, результат будет в разделе «Мои сайты».</p>
  </div>
  {% elif job.status == 'failed' %}
  <div class="card">
    <p>Проверка не удалась: {{ job.error }}</p>
    <p class="muted small" style="margin-top:8px">Проверьте, что сайт открывается, и запустите заново со страницы сайта.</p>
  </div>
  {% else %}
  {% set r = job.result %}
  {% if r.sources_mode == 'fake' %}
  <div class="note fake">Данные о спросе, позициях и ответах нейросети — виртуальные: сервис работает в тестовом режиме, без обращений к Яндексу.</div>
  {% endif %}

  <section class="card">
    <div class="hero">
      <div class="score {{ color }}">{{ a.total if a.total is not none else '—' }}</div>
      <div>
        <h2 style="margin-bottom:6px">Оценка сайта из 100</h2>
        {% set pages_n = r.free.audit.pages_crawled %}{% set found_n = r.free.audit.issues|length + (r.free.geo.issues or [])|length %}
        <p class="muted">Проверили {{ pages_n }} {{ pages_n|plural('страницу', 'страницы', 'страниц') }}, нашли {{ found_n }} {{ found_n|plural('замечание', 'замечания', 'замечаний') }}.</p>
        <p style="margin-top:14px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
          <a class="btn" href="/jobs/{{ job.id }}/report">Открыть полный отчёт</a>
          {% if plan.pdf %}<a class="btn ghost" href="/jobs/{{ job.id }}/report.pdf">Скачать PDF</a>{% else %}<span class="muted">PDF отчёта — в <a href="/billing">платных тарифах</a>.</span>{% endif %}</p>
        {% if feats.share %}
        <form class="share" method="post" action="/jobs/{{ job.id }}/{{ 'unshare' if job.share_token else 'share' }}">
          <input type="hidden" name="csrf" value="{{ user.csrf }}">
          {% if job.share_token %}
          <label class="small muted" for="share-link">Ссылка на отчёт без входа — для клиента или коллеги</label>
          <div class="row"><input id="share-link" type="text" readonly value="{{ base_url }}/r/{{ job.share_token }}">
          <button class="btn ghost" type="submit">Отключить ссылку</button></div>
          {% else %}<button class="linkbtn small" type="submit">Сделать ссылку на отчёт без входа</button>{% endif %}
        </form>
        {% endif %}
      </div>
    </div>
    <div class="lights" style="margin-top:22px">
      {% for l in a.lights %}
      <div class="light"><span class="dot {{ l.color }}"></span>{{ l.name }}<b>{{ l.score if l.score is not none else '—' }}</b>{% if l.note %}<span class="muted small">{{ l.note }}</span>{% endif %}</div>
      {% endfor %}
    </div>
  </section>

  {% set ch = r.free.checks %}
  {% if ch %}
  <section class="card">
    <h2>Открывается ли сайт поиску</h2>
    <p class="muted small" style="margin:-6px 0 12px">Что видит поисковый робот Яндекса и работает ли защищённое соединение (HTTPS).</p>
    <ul class="plain">
      {% set v = ch.access.verdict %}
      <li><span class="dot {{ {'real': 'green', 'stub': 'red', 'down': 'red'}.get(v, 'yellow') }}"></span>
        {{ {'real': 'Поиск видит сайт так же, как посетитель', 'stub': 'Вместо сайта поиск видит заглушку защиты — оценка не выставлена',
            'empty': 'Текст страницы появляется только после загрузки скриптов — поиск может его не увидеть', 'differs': 'Поиску сайт показывает меньше текста, чем посетителю',
            'down': 'Сайт не открылся'}[v] }}
        <span class="muted small">· {{ ch.access.evidence }}</span></li>
      {% if ch.https %}
      {% set tls = ch.https.tls %}
      <li><span class="dot {{ 'green' if tls.ok else 'red' }}"></span>
        {% if tls.ok %}Защищённое соединение работает, сертификат действует до {{ tls.not_after[:10] }}{% if tls.issuer %} <span class="muted small">· {{ tls.issuer }}</span>{% endif %}
        {% elif tls.no_tls %}Сайт не открывается по защищённому адресу (https){% else %}Сертификат защищённого соединения недействителен <span class="muted small">· {{ tls.error }}</span>{% endif %}</li>
      <li><span class="dot {{ 'green' if ch.https.mirrors.main else 'yellow' }}"></span>
        {% if ch.https.mirrors.main %}Один главный адрес: {{ ch.https.mirrors.main }}{% else %}Сайт открывается по нескольким адресам, и поиск считает их разными сайтами{% endif %}</li>
      {% endif %}
    </ul>
  </section>
  {% endif %}

  {% if diff %}
  <section class="card">
    <h2>С прошлой проверки <a class="muted small" href="/jobs/{{ diff.prev_id }}">№{{ diff.prev_id }}</a></h2>
    <div class="diff-nums">
      <div><b class="{{ 'up' if (diff.score_delta or 0) > 0 else ('down' if (diff.score_delta or 0) < 0 else '') }}">{% if diff.score_delta is none %}—{% elif diff.score_delta > 0 %}+{{ diff.score_delta }}{% else %}{{ diff.score_delta }}{% endif %}</b>оценка</div>
      <div><b class="up">{{ diff.fixed_count }}</b>исправлено</div>
      <div><b class="{{ 'down' if diff.new_count }}">{{ diff.new_count }}</b>появилось</div>
      <div><b>{{ diff.kept_count }}</b>осталось</div>
    </div>
    {% if diff.fixed %}<h3 style="margin-top:18px">Исправлено</h3>
    <ul class="plain">{% for g in diff.fixed %}<li><span class="dot green"></span>{{ g.title }}{% if g.pages > 1 %} <span class="muted">· {{ g.pages }} стр.</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
    {% if diff.new %}<h3 style="margin-top:18px">Появилось</h3>
    <ul class="plain">{% for g in diff.new %}<li><span class="dot red"></span>{{ g.title }}{% if g.pages > 1 %} <span class="muted">· {{ g.pages }} стр.</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
    {% if diff.positions %}<h3 style="margin-top:18px">Позиции</h3>
    <ul class="plain">{% for m in diff.positions %}<li><span class="{{ 'up' if m.delta > 0 else 'down' }}">{{ '▲' if m.delta > 0 else '▼' }}</span> {{ m.query }}: {{ m.before or 'вне топ-10' }} → {{ m.after or 'вне топ-10' }}</li>{% endfor %}</ul>{% endif %}
  </section>
  {% endif %}

  {% if a.steps %}
  <section class="card">
    <h2>Что сделать первым</h2>
    <ol class="steps">
      {% for s in a.steps[:(steps_shown if steps_shown is not none else 7)] %}
      <li><b>{{ s.title }}</b><br><span class="muted small">{{ s.action }} · {{ s.who }} · {{ s.time }}</span></li>
      {% endfor %}
    </ol>
    {% if steps_shown is not none and a.steps|length > steps_shown %}
    <p class="note" style="margin-top:12px">Ещё {{ a.steps|length - steps_shown }} шагов открываются на <a href="/billing">платном тарифе</a>.</p>
    {% endif %}
  </section>
  {% endif %}

  {% for key in ('demand', 'positions', 'answers') %}
  {% set sec = r.paid[key] %}
  <section class="card table-scroll">
    <h2>{{ SECTION_TITLES[key] }} <span class="pill {{ sec.status }}" style="vertical-align:middle">{{ SECTION_STATUS[sec.status] }}</span></h2>
    <p class="muted small" style="margin:-6px 0 12px">{{ SECTION_HINTS[key] }}</p>
    {% if sec.reason %}<p class="muted small" style="margin-bottom:12px">{{ sec.reason }}</p>{% endif %}
    {% set watched = r.rivals or [] %}
    {% if key == 'positions' and r.region and r.region != 225 %}<p class="muted small" style="margin-bottom:12px">Выдача: {{ region_name(r.region) }}.</p>{% endif %}
    {% if sec['items'] %}
    <table>
      {% if key == 'demand' %}
      <thead><tr><th>Фраза</th><th class="num">Ищут раз в месяц</th></tr></thead>
      <tbody>{% for it in sec['items'] %}<tr><td>{{ it.query }}</td><td class="num">{{ it.error or it.freq|num }}</td></tr>{% endfor %}</tbody>
      {% elif key == 'positions' %}
      <thead><tr><th>Фраза</th><th class="num">Ваше место</th>{% for w in watched %}<th class="num">{{ w }}</th>{% endfor %}<th>Кто на первых местах</th></tr></thead>
      <tbody>{% for it in sec['items'] %}<tr><td>{{ it.query }}</td>
        <td class="num">{% if it.error %}ошибка{% else %}{{ it.position or 'нет в топ-10' }}{% endif %}</td>
        {% for w in watched %}<td class="num muted">{{ (it.watched or {}).get(w) or '—' }}</td>{% endfor %}
        <td class="muted">{{ (it.top3 or [])|join(', ') }}</td></tr>{% endfor %}</tbody>
      {% else %}
      <thead><tr><th>Фраза</th><th>Называет вас</th>{% for w in watched %}<th>{{ w }}</th>{% endfor %}<th>Кого называет вместо вас</th></tr></thead>
      <tbody>{% for it in sec['items'] %}<tr><td>{{ it.query }}</td>
        <td>{% if it.error %}ошибка{% elif it.cited %}да, источник №{{ it.cited_position }}{% else %}нет{% endif %}</td>
        {% for w in watched %}<td class="muted">{% if (it.watched or {}).get(w) %}да{% elif it.watched %}нет{% else %}—{% endif %}</td>{% endfor %}
        <td class="muted">{{ (it.rivals or [])|join(', ') }}</td></tr>{% endfor %}</tbody>
      {% endif %}
    </table>
    {% elif not sec.reason %}<p class="muted">Нет данных.</p>{% endif %}
  </section>
  {% endfor %}

  {% endif %}
</div>
{% endblock %}
