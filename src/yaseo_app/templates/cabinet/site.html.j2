{% extends "cabinet/base.html.j2" %}
{% block title %}{{ site.url }}{% endblock %}
{% block main %}
<div class="stack">
  <div>
    <div class="crumbs"><a href="/sites">Сайты</a> /</div>
    <h1 style="text-transform:none">{{ site.url }}</h1>
  </div>
  <form class="card" method="post" action="/sites/{{ site.id }}/run">
    <input type="hidden" name="csrf" value="{{ user.csrf }}">
    <h2>Новая проверка</h2>
    <div class="field"><label for="queries">Что клиенты пишут в Яндексе, когда ищут ваши услуги
      <span class="hint">Каждая фраза — с новой строки. На вашем тарифе — до {{ plan.queries_per_audit or 30 }}.</span></label>
      <textarea id="queries" name="queries" placeholder="ремонт квартир в краснодаре&#10;дизайн интерьера">{{ queries or '' }}</textarea></div>
    <p class="muted small" style="margin-top:8px">Можно оставить пустым — тогда проверим только сайт: ошибки и готовность к нейросетям. С фразами покажем ещё, сколько людей их ищет, на каком месте вы в Яндексе и упоминает ли вас нейросеть Яндекса.</p>
    <p style="margin-top:18px"><button class="btn" type="submit">Запустить проверку</button></p>
    {% if error %}<div class="error" role="alert">{{ error }}</div>{% endif %}
  </form>
  <section class="card table-scroll" id="positions">
    <h2>Место в Яндексе — каждый день</h2>
    <p class="muted" style="margin-bottom:14px">Каждую ночь смотрим, на каком месте ваш сайт в поиске Яндекса по выбранным фразам, и раз в неделю присылаем письмо: что выросло, что упало.</p>
    {% if quota.limit %}
    <p class="muted small" style="margin-bottom:14px">Смотрим первую десятку результатов по всей России. Фраз под наблюдением: {{ quota.used }} из {{ quota.limit }} по тарифу.</p>
    {% if positions %}
    <table>
      <thead><tr><th>Фраза</th><th class="num">Место</th><th class="num">За неделю</th><th>30 дней</th><th></th></tr></thead>
      <tbody>{% for p in positions %}
        <tr><td>{{ p.query }}</td>
          <td class="num">{% if p.day %}{{ p.position or 'вне топ-10' }}{% else %}<span class="muted">ждёт съёма</span>{% endif %}</td>
          <td class="num">{% if p.delta %}<span class="{{ 'up' if p.delta > 0 else 'down' }}">{{ '▲' if p.delta > 0 else '▼' }} {{ p.delta|abs }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
          <td class="spark-cell">{{ p.spark|safe }}</td>
          <td class="num"><form method="post" action="/sites/{{ site.id }}/track/{{ p.id }}/delete">
            <input type="hidden" name="csrf" value="{{ user.csrf }}">
            <button class="linkbtn small" type="submit" aria-label="Убрать {{ p.query }}">убрать</button></form></td></tr>
      {% endfor %}</tbody>
    </table>
    {% endif %}
    <form method="post" action="/sites/{{ site.id }}/track" style="margin-top:16px">
      <input type="hidden" name="csrf" value="{{ user.csrf }}">
      <div class="field" style="margin-top:0"><label for="track">Добавить фразы — каждую с новой строки</label>
        <textarea id="track" name="queries" style="min-height:80px">{{ track_text or '' }}</textarea></div>
      <p style="margin-top:12px"><button class="btn ghost" type="submit">Следить</button></p>
      {% if track_error %}<div class="error" role="alert">{{ track_error }}</div>{% endif %}
    </form>
    {% else %}
    <p class="muted">Доступно в тарифах от «Старт». <a href="/billing">Тарифы</a></p>
    {% endif %}
  </section>

  <div class="card table-scroll">
    <h2>История</h2>
    {% if jobs %}
    <table>
      <thead><tr><th>№</th><th>Статус</th><th class="num">Оценка</th><th class="num">Фраз</th><th class="num">Запущена</th><th class="num">Расход</th></tr></thead>
      <tbody>
      {% for j in jobs %}
        <tr>
          <td><a href="/jobs/{{ j.id }}">{{ j.id }}</a></td>
          <td><span class="pill {{ j.status }}">{{ STATUS_TITLES[j.status] }}</span>{% if j.sources_mode == 'fake' %} <span class="pill">виртуальные данные</span>{% endif %}</td>
          <td class="num"><span class="score-xs {{ color_of(j.score) }}">{{ j.score if j.score is not none else '—' }}</span></td>
          <td class="num muted">{{ j.queries or '—' }}</td>
          <td class="num muted">{{ j.created_at|dt }}</td>
          <td class="num">{{ j.cost_rub|money }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="muted">Проверок ещё не было.</p>{% endif %}
  </div>
  <form method="post" action="/sites/{{ site.id }}/delete" onsubmit="return confirm('Удалить сайт из кабинета? Отчёты останутся недоступны.')">
    <input type="hidden" name="csrf" value="{{ user.csrf }}">
    <button class="linkbtn small" type="submit">Удалить сайт из кабинета</button>
  </form>
</div>
{% endblock %}
