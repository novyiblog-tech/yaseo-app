{% extends "cabinet/base.html.j2" %}
{% block title %}{{ site.url }}{% endblock %}
{% block main %}
<div class="stack">
  <div>
    <div class="crumbs"><a href="/sites">Сайты</a> /</div>
    <h1 style="text-transform:none">{{ site.url }}</h1>
  </div>
  <form class="card" method="post" action="/sites/{{ site.id }}/run">
    <input type="hidden" name="csrf" value="{{ user.csrf }}">
    <h2>Новая проверка</h2>
    {% if plan.queries_per_audit %}
    <div class="field"><label for="queries">Что клиенты пишут в Яндексе, когда ищут ваши услуги
      <span class="hint">Каждая фраза — с новой строки. На вашем тарифе — до {{ plan.queries_per_audit }}.</span></label>
      <textarea id="queries" name="queries" placeholder="ремонт квартир в краснодаре&#10;дизайн интерьера">{{ queries or '' }}</textarea></div>
    <p class="muted small" style="margin-top:8px">Можно оставить пустым — тогда проверим только сайт: ошибки и готовность к нейросетям. С фразами покажем ещё, сколько людей их ищет, на каком месте вы в Яндексе и упоминает ли вас нейросеть Яндекса.</p>
    {% else %}
    <p class="muted small" style="margin-top:8px">Бесплатно проверяем сайт: ошибки и готовность к нейросетям, до {{ plan.max_pages }} страниц. Спрос, место в Яндексе и ответы нейросети по вашим фразам — с <a href="/billing">промокодом</a> или на платном тарифе.</p>
    {% endif %}
    <p style="margin-top:18px"><button class="btn" type="submit">Запустить проверку</button></p>
    {% if error %}<div class="error" role="alert">{{ error }}</div>{% endif %}
  </form>
  <section class="card table-scroll" id="positions">
    <h2>Место в Яндексе — каждый день</h2>
    <p class="muted" style="margin-bottom:14px">Каждую ночь смотрим, на каком месте ваш сайт в поиске Яндекса по выбранным фразам, и раз в неделю присылаем письмо: что выросло, что упало.</p>
    {% if quota.limit %}
    <p class="muted small" style="margin-bottom:14px">Смотрим первую десятку результатов{% if eff.region == 225 %} по всей России{% else %}, выдача — {{ region_name(eff.region) }}{% endif %}. Фраз под наблюдением: {{ quota.used }} из {{ quota.limit }} по тарифу.</p>
    {% if positions %}
    <table>
      <thead><tr><th>Фраза</th><th class="num">Место</th>{% for w in eff.rivals %}<th class="num">{{ w }}</th>{% endfor %}<th class="num">За неделю</th><th>30 дней</th><th></th></tr></thead>
      <tbody>{% for p in positions %}
        <tr><td>{{ p.query }}</td>
          <td class="num">{% if p.day %}{{ p.position or 'вне топ-10' }}{% else %}<span class="muted">ждёт съёма</span>{% endif %}</td>
          {% for w in eff.rivals %}<td class="num muted">{{ p.rivals.get(w) or '—' }}</td>{% endfor %}
          <td class="num">{% if p.delta %}<span class="{{ 'up' if p.delta > 0 else 'down' }}">{{ '▲' if p.delta > 0 else '▼' }} {{ p.delta|abs }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
          <td class="spark-cell">{{ p.spark|safe }}</td>
          <td class="num"><form method="post" action="/sites/{{ site.id }}/track/{{ p.id }}/delete">
            <input type="hidden" name="csrf" value="{{ user.csrf }}">
            <button class="linkbtn small" type="submit" aria-label="Убрать {{ p.query }}">убрать</button></form></td></tr>
      {% endfor %}</tbody>
    </table>
    {% endif %}
    <form method="post" action="/sites/{{ site.id }}/track" style="margin-top:16px">
      <input type="hidden" name="csrf" value="{{ user.csrf }}">
      <div class="field" style="margin-top:0"><label for="track">Добавить фразы — каждую с новой строки</label>
        <textarea id="track" name="queries" style="min-height:80px">{{ track_text or '' }}</textarea></div>
      <p style="margin-top:12px"><button class="btn ghost" type="submit">Следить</button></p>
      {% if track_error %}<div class="error" role="alert">{{ track_error }}</div>{% endif %}
    </form>
    {% else %}
    <p class="muted">Доступно в тарифах от «Старт». <a href="/billing">Тарифы</a></p>
    {% endif %}
  </section>

  {% macro locked(code) %}<span class="muted small">с тарифа «{{ feature_plan[code] }}» · <a href="/billing">тарифы</a></span>{% endmacro %}
  {# сводка: что действует сейчас; менять — на отдельной странице #}
  {% macro tag(code) %}{% if not feats[code] %} <span class="muted small">· с «{{ feature_plan[code] }}»</span>{% endif %}{% endmacro %}
  {% set any_feat = feats.region or feats.schedule or feats.exclude or feats.gentle or feats.sections or feats.rivals %}
  <section class="card" id="settings">
    <div class="card-head"><h2>Настройки сайта</h2>
      {% if any_feat %}<a class="btn ghost" href="/sites/{{ site.id }}/settings">Изменить</a>
      {% else %}<a class="btn ghost" href="/billing">Тарифы</a>{% endif %}</div>
    <dl class="prefs-sum">
      <div><dt>Город</dt><dd>{{ region_name(eff.region) }}{{ tag('region') }}</dd></div>
      <div><dt>Автопроверка</dt><dd>{{ 'выключена' if eff.schedule == 'off' else schedules[eff.schedule] }}{{ tag('schedule') }}</dd></div>
      <div><dt>Исключённые разделы</dt><dd>{{ eff.exclude|length if eff.exclude else 'нет' }}{{ tag('exclude') }}</dd></div>
      <div><dt>Обход</dt><dd>{{ 'бережный' if eff.gentle else 'обычный' }}{{ tag('gentle') }}</dd></div>
      <div><dt>Собираем</dt><dd>{{ 'всё' if not eff.off else (3 - eff.off|length)|string + ' из 3 разделов' }}{{ tag('sections') }}</dd></div>
      <div><dt>Конкуренты</dt><dd>{{ eff.rivals|length if eff.rivals else 'нет' }}{{ tag('rivals') }}</dd></div>
    </dl>
  </section>

  <section class="card">
    <h2>Яндекс Вебмастер и Метрика</h2>
    {% if not feats.webmaster %}<p class="muted small">Настоящие показы, клики и переходы из поиска прямо в кабинете · {{ locked('webmaster') }}</p>
    {% elif yandex_link %}<p class="muted small">Показы и клики из Вебмастера, переходы из Метрики — за 28 дней, берём у Яндекса при открытии и не храним.</p>
      <p style="margin-top:12px"><a class="btn ghost" href="/sites/{{ site.id }}/yandex">Открыть данные Яндекса</a></p>
    {% elif not yandex_ready %}<p class="muted small">Настоящие показы, клики и переходы из поиска. Подключение появится, когда сервис зарегистрирует приложение в Яндекс ID.</p>
    {% else %}<p class="muted small">Подключите Яндекс ID, на котором сайт подтверждён в Вебмастере и стоит счётчик Метрики, — покажем настоящие показы, клики и переходы из поиска. <a href="/settings#yandex">Подключить в настройках</a>.</p>{% endif %}
  </section>

  <div class="card table-scroll">
    <h2>История</h2>
    {% if jobs %}
    <table class="history">
      <thead><tr><th>№</th><th>Статус</th><th class="num">Оценка</th><th class="num">Фраз</th><th class="num">Запущена</th><th></th></tr></thead>
      <tbody>
      {% for j in jobs %}
        {# вся строка — ссылка на проверку (a::after растянут на строку) #}
        <tr class="row-link">
          <td><a href="/jobs/{{ j.id }}" aria-label="Проверка № {{ j.id }} от {{ j.created_at|dt }}">{{ j.id }}</a></td>
          <td><span class="pill {{ j.status }}">{{ STATUS_TITLES[j.status] }}</span>{% if j.sources_mode == 'fake' %} <span class="pill">виртуальные данные</span>{% endif %}</td>
          <td class="num"><span class="score-xs {{ color_of(j.score) }}">{{ j.score if j.score is not none else '—' }}</span></td>
          <td class="num muted">{{ j.queries or '—' }}</td>
          <td class="num muted">{{ j.created_at|dt }}</td>
          <td class="num row-go" aria-hidden="true">Открыть →</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="muted">Проверок ещё не было.</p>{% endif %}
  </div>
  <form method="post" action="/sites/{{ site.id }}/delete" onsubmit="return confirm('Удалить сайт из кабинета? Отчёты останутся недоступны.')">
    <input type="hidden" name="csrf" value="{{ user.csrf }}">
    <button class="linkbtn small" type="submit">Удалить сайт из кабинета</button>
  </form>
</div>
{% endblock %}
