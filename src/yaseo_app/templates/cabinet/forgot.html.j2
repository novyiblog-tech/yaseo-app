{% extends "cabinet/base.html.j2" %}
{% block title %}Восстановить пароль{% endblock %}
{% block main %}
<div class="auth card">
  <h1>Новый пароль</h1>
  <p class="muted small">Пришлём ссылку, по которой можно задать новый пароль.</p>
  <form method="post" action="/forgot">
    <div class="field"><label for="email">Почта</label>
      <input id="email" type="email" name="email" autocomplete="email" required></div>
    <p style="margin-top:22px"><button class="btn" type="submit">Прислать ссылку</button></p>
  </form>
</div>
{% endblock %}
