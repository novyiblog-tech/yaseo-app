{% extends "cabinet/base.html.j2" %}
{% block title %}Тариф{% endblock %}
{% block main %}
{% set p = cur.plan %}
{% macro meter(label, used, limit) %}
  <div class="meter">
    <div class="meter-head"><span>{{ label }}</span>{% if limit != 0 %}<span>{{ used }}{% if limit is not none %} из {{ limit }}{% endif %}</span>{% endif %}</div>
    {% if limit %}<div class="bar-track"><i style="width:{{ [100, (used / limit * 100)|round|int]|min }}%"></i></div>
    {% elif limit == 0 %}<div class="muted small">не входит в тариф</div>{% endif %}
  </div>
{% endmacro %}
<div class="stack">
  <h1>Тариф и оплата</h1>
  {% if fake %}<div class="note fake">Тестовый режим: оплата виртуальная, деньги не списываются.</div>{% endif %}
  {% if error %}<div class="error" role="alert">{{ error }}</div>{% endif %}

  <section class="card">
    <div class="row" style="justify-content:space-between;align-items:flex-start">
      <div>
        <div class="muted small">Сейчас</div>
        <h2 style="margin:4px 0 6px">{{ p.title }}</h2>
        <p class="muted small">
        {% if p.period == 'free' %}{% if p.audits_per_period == 1 %}Одна проверка{% else %}{{ p.audits_per_period }} {{ p.audits_per_period|plural('проверка', 'проверки', 'проверок') }}{% endif %} за {{ p.free_every_days }} дней, {% if p.steps_shown %}первые {{ p.steps_shown }} {{ p.steps_shown|plural('шаг', 'шага', 'шагов') }} плана исправлений{% else %}полный план исправлений{% endif %}{% if p.pdf %} и PDF отчёта{% endif %}.{% if cur.sub and cur.end %} Действует до {{ cur.end|dt }}.{% endif %}
        {% elif cur.sub.status == 'past_due' %}Не удалось списать оплату. Повторим в течение трёх дней, потом тариф станет бесплатным.
        {% elif p.period == 'once' %}Действует до {{ cur.end|dt }}, без продления.
        {% elif cur.sub.auto_renew %}Продлится {{ cur.end|dt }} на {{ p.price_rub|rub }}.
        {% else %}Действует до {{ cur.end|dt }}, продление выключено.{% endif %}
        </p>
      </div>
      {% if p.period == 'month' %}
      <form method="post" action="/billing/auto-renew">
        <input type="hidden" name="csrf" value="{{ user.csrf }}">
        <input type="hidden" name="on" value="{{ 'no' if cur.sub.auto_renew else 'yes' }}">
        <button class="btn ghost" type="submit">{{ 'Выключить продление' if cur.sub.auto_renew else 'Включить продление' }}</button>
      </form>
      {% endif %}
    </div>
    <div class="meters">
      {{ meter('Сайты', use.sites, p.sites) }}
      {{ meter('Проверки за период', use.audits, p.audits_per_period) }}
      {{ meter('Проверки в нейросетях', use.ai_checks, p.ai_checks) }}
    </div>
  </section>

  <section>
    <h2>Тарифы</h2>
    <div class="plans">
      {% for t in plans %}
      <div class="plan{% if t.code == p.code %} current{% endif %}">
        <h3>{{ t.title }}</h3>
        <div class="price">{{ t.price_rub|rub }}{% if t.period == 'month' %}<span>/мес</span>{% elif t.period == 'once' %}<span> разово</span>{% endif %}</div>
        <ul class="plain small">
          <li>{{ t.sites }} {{ 'сайт' if t.sites == 1 else 'сайта' if t.sites < 5 else 'сайтов' }}</li>
          <li>{% if t.period == 'free' %}проверка раз в {{ t.free_every_days }} дней{% else %}{{ t.audits_per_period }} полн. аудит{{ '' if t.audits_per_period == 1 else 'ов' if t.audits_per_period >= 5 else 'а' }} за 30 дней{% endif %}</li>
          <li>до {{ t.queries_per_audit }} запросов в аудите</li>
          <li>{% if t.ai_checks %}{{ t.ai_checks }} проверок в нейросетях{% else %}<span class="muted">без нейросетей</span>{% endif %}</li>
          {% if t.tracked_queries %}<li>{{ t.tracked_queries }} запросов под наблюдением <span class="muted">— скоро</span></li>{% endif %}
          <li>{% if t.pdf %}PDF отчёта{% else %}<span class="muted">без PDF</span>{% endif %}</li>
          {% if t.white_label %}<li>свой логотип в отчёте <span class="muted">— скоро</span></li>{% endif %}
        </ul>
        {# у каждой карточки одно и то же место внизу: кнопка или состояние того же размера #}
        <div class="plan-foot">
        {% if t.code == p.code %}<span class="btn state current">✓ ваш тариф</span>
        {% elif t.period == 'free' %}<span class="btn state">Бесплатно</span>
        {% else %}
        <form method="post" action="/billing/buy">
          <input type="hidden" name="csrf" value="{{ user.csrf }}">
          <input type="hidden" name="plan" value="{{ t.code }}">
          <button class="btn" type="submit">{{ 'Купить' if t.period == 'once' else 'Подключить' }}</button>
        </form>
        {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <p class="muted small">Нажимая «Купить» или «Подключить», вы принимаете <a href="/legal/offer">оферту</a>. Ежемесячный тариф продлевается автоматически с той же карты — отключить продление можно здесь в любой момент, доступ сохранится до конца оплаченного периода.</p>

  {% if payments %}
  <section class="card table-scroll">
    <h2>Платежи</h2>
    <table>
      <thead><tr><th>Дата</th><th>Тариф</th><th>За что</th><th>Статус</th><th class="num">Сумма</th></tr></thead>
      <tbody>{% for x in payments %}
        <tr><td class="muted">{{ x.created_at|dt }}</td><td>{{ x.title }}</td>
          <td class="muted">{{ 'продление' if x.purpose == 'renewal' else 'покупка' }}</td>
          <td><span class="pill {{ {'succeeded': 'ok', 'pending': 'queued', 'canceled': 'failed'}[x.status] }}">{{ {'succeeded': 'оплачен', 'pending': 'ждёт оплаты', 'canceled': 'не прошёл'}[x.status] }}</span></td>
          <td class="num">{{ x.amount_rub|rub }}</td></tr>
      {% endfor %}</tbody>
    </table>
  </section>
  {% endif %}
</div>
{% endblock %}
