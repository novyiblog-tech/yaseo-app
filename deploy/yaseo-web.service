[Unit]
Description=yaseo: веб (кабинет, лендинг, оферта)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=yaseo
WorkingDirectory=/opt/yaseo-app
EnvironmentFile=/etc/yaseo/app.env
ExecStart=/opt/yaseo-app/.venv/bin/uvicorn yaseo_app.web:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
