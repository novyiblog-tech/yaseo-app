# /etc/yaseo/app.env на сервере, права 0640 root:yaseo. В git не кладётся.
YASEO_APP_DSN=dbname=yaseo_app
YASEO_ENV_FILE=/etc/yaseo/app.env
YASEO_BASE_URL=https://yaseo.site
YASEO_SITE_DOMAIN=yaseo.site
YASEO_MAIL_FROM=noreply@yaseo.site
YASEO_SUPPORT_EMAIL=help@yaseo.site
# Длинная случайная строка: openssl rand -hex 32. Не менять после запуска —
# перестанут работать ссылки отписки и подтверждения в уже отправленных письмах.
YASEO_SECRET=

# Источники данных: fake — без трат, live — Яндекс по ключам ниже.
YASEO_SOURCES=fake
YC_FOLDER_ID=
YANDEX_AI_STUDIO_API_KEY=

# Почта. Пока YASEO_SMTP_HOST пуст, письма не уходят, а пишутся в журнал.
YASEO_SMTP_HOST=
YASEO_SMTP_PORT=587
YASEO_SMTP_USER=
YASEO_SMTP_PASSWORD=

# Оплата: fake, пока нет ИП и договора с платёжным сервисом.
YASEO_PAYMENTS=fake

# Реквизиты для оферты — когда будет выбрано ИП.
YASEO_OPERATOR=
YASEO_OPERATOR_INN=
YASEO_OPERATOR_OGRNIP=
YASEO_OPERATOR_ADDRESS=
YASEO_VAT_NOTE=

# Вебмастер и Метрика в кабинете: приложение на oauth.yandex.ru с правами
# «Вебмастер: информация о сайтах» и «Метрика: статистика», адрес возврата
# https://yaseo.site/settings/yandex/callback. Пусто — кнопка подключения скрыта.
YASEO_YANDEX_CLIENT_ID=
YASEO_YANDEX_CLIENT_SECRET=
